---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import PageHero from "../../components/PageHero.astro";
import BoardCommitteeGrid from "../../components/BoardCommitteeGrid.astro";
import Footer from "../../components/Footer.astro";

export async function getStaticPaths() {
  const allMembers = await getCollection("board");
  const currentYear = Math.max(...allMembers.map((m) => m.data.termStartYear));
  const terms = [...new Set(allMembers.map((m) => m.data.term))];

  return terms.map((term) => {
    const termMembers = allMembers.filter((m) => m.data.term === term);
    const isCurrent = termMembers[0].data.termStartYear === currentYear;
    return { params: { term }, props: { termMembers, isCurrent } };
  });
}

const { termMembers, isCurrent } = Astro.props;
const members = termMembers.sort((a, b) => a.data.tier - b.data.tier || a.data.order - b.data.order);
const term = Astro.params.term;
---

<Layout
  title={`${term} Committee`}
  description={`The Mysuru District Photographers and Videographers Association ® executive committee for the ${term} term.`}
>
  <Header />
  <PageHero
    eyebrow={`Executive Committee · ${term}`}
    title={`The ${term} committee`}
    description="Office bearers and directors who led the association through this term."
  />

  <section class="bg-mdpva-paper px-5 py-[clamp(48px,7vw,90px)] sm:px-8 lg:px-16">
    <BoardCommitteeGrid members={members} />
  </section>

  <section class="bg-mdpva-ink px-5 py-[clamp(48px,7vw,80px)] text-mdpva-cream sm:px-8 lg:px-16">
    <div class="mx-auto flex max-w-[840px] flex-col items-center gap-5 text-center" data-reveal>
      {
        isCurrent ? (
          <p class="max-w-[560px] text-[15px] leading-relaxed text-mdpva-cream/70">
            This is the current executive committee.
          </p>
        ) : (
          <p class="max-w-[560px] text-[15px] leading-relaxed text-mdpva-cream/70">
            Looking for the current executive committee?
          </p>
        )
      }
      <a
        href="/board"
        class="rounded-sm border border-mdpva-cream/40 px-6 py-3 text-[13px] font-semibold tracking-wider text-mdpva-cream uppercase transition-colors hover:bg-white hover:text-mdpva-ink"
      >
        ← Back to current board
      </a>
    </div>
  </section>
  <Footer />
</Layout>
