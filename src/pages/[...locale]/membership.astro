---
import { getLocale, useTranslations, localizePath } from "../../i18n/utils";

const locale = getLocale(Astro.url);
const t = useTranslations(locale);
const L = (path: string) => localizePath(path, locale);
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import PageHero from "../../components/PageHero.astro";
import MembershipBenefits from "../../components/MembershipBenefits.astro";
import TestimonialsMarquee from "../../components/TestimonialsMarquee.astro";
import Footer from "../../components/Footer.astro";

export function getStaticPaths() {
  return [{ params: { locale: undefined } }, { params: { locale: "kn" } }];
}

// Tier-neutral by design — membership categories and fees are deliberately not
// published, so nothing here may imply that some members receive more than
// others. Copy salvaged from the retired membership-plans collection.
const includes = [
  t("membership.includes.1"),
  t("membership.includes.2"),
  t("membership.includes.3"),
  t("membership.includes.4"),
  t("membership.includes.5"),
  t("membership.includes.6"),
];

const coverage = [
  {
    title: t("membership.who.title"),
    body: t("membership.who.body"),
  },
  {
    title: t("membership.covers.title"),
    body: t("membership.covers.body"),
  },
];
---

<Layout
  title={t("membership.meta.title")}
  description={t("membership.meta.description")}
>
  <Header />
  <PageHero
    eyebrow={t("membership.hero.eyebrow")}
    title={t("membership.hero.title")}
    description={t("membership.hero.description")}
  />

  <section
    id="apply"
    class="overflow-hidden bg-mdpva-paper px-5 py-[clamp(48px,7vw,90px)] sm:px-8 lg:px-16"
  >
    <div class="mx-auto grid max-w-[1100px] items-start gap-10 lg:grid-cols-[1.4fr_1fr] lg:gap-16">
      <div data-reveal>
        <div class="mb-3.5 text-xs font-semibold tracking-[0.22em] text-mdpva-accent uppercase">
          {t("membership.includes.eyebrow")}
        </div>
        <h2 class="text-pretty mb-8 max-w-[520px] font-serif text-[clamp(24px,3vw,34px)] font-normal">
          {t("membership.includes.heading")}
        </h2>
        <ul class="m-0 flex list-none flex-col gap-4 p-0">
          {
            includes.map((item) => (
              <li class="flex items-start gap-3.5 text-[15px] leading-relaxed text-mdpva-body">
                <svg
                  width="17"
                  height="17"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.2"
                  aria-hidden="true"
                  class="mt-1 shrink-0 text-mdpva-accent"
                >
                  <path d="M5 13l4 4L19 7" />
                </svg>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div
        class="relative isolate overflow-hidden bg-mdpva-ink p-8 text-mdpva-cream sm:p-10"
        data-reveal
        style="--reveal-delay:150ms"
      >
        {/* Ambient loop B — aperture turning slowly behind the card content.
            Transform-only, so it composites on the GPU. Clipped by the card's
            own overflow-hidden, which also keeps it off the page's width. */}
        <svg
          class="mdpva-aperture pointer-events-none absolute -top-24 -right-24 -z-10 h-[420px] w-[420px] text-mdpva-gold opacity-[0.07]"
          viewBox="-110 -110 220 220"
          fill="none"
          stroke="currentColor"
          stroke-width="3"
          aria-hidden="true"
        >
          <circle cx="0" cy="0" r="100" />
          <path d="M45 0 22.5 38.97 -22.5 38.97 -45 0 -22.5 -38.97 22.5 -38.97Z" />
          <path d="M45 0 57.36 81.92" />
          <path d="M22.5 38.97 -42.26 90.63" />
          <path d="M-22.5 38.97 -99.62 8.72" />
          <path d="M-45 0 -57.36 -81.92" />
          <path d="M-22.5 -38.97 42.26 -90.63" />
          <path d="M22.5 -38.97 99.62 -8.72" />
        </svg>

        {/* Ambient loop A — gold segment travelling the card's border.
            pathLength="100" normalises the perimeter so the dash values in
            global.css hold at any card size. overflow-visible stops the SVG
            clipping the outer half of the stroke. */}
        <svg
          class="mdpva-trace pointer-events-none absolute inset-0 h-full w-full overflow-visible text-mdpva-gold"
          aria-hidden="true"
        >
          <rect
            x="0"
            y="0"
            width="100%"
            height="100%"
            pathLength="100"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          />
        </svg>

        <h2 class="font-serif text-[26px] font-medium">{t("membership.apply.heading")}</h2>
        <p class="mt-4 text-sm leading-relaxed text-mdpva-cream/70">
          {t("membership.apply.body")}
        </p>
        <a
          href={L("/contact")}
          class="mt-7 block rounded-sm bg-mdpva-accent px-6 py-3.5 text-center text-[13px] font-semibold tracking-wider text-mdpva-cream uppercase transition-colors hover:bg-mdpva-accent-hover"
        >
          {t("membership.apply.cta")}
        </a>
        <p class="mt-4 text-center text-[13px] text-mdpva-cream/60">
          {t("membership.apply.or")}{" "}
          <a href="mailto:office@mdpva.in" class="text-mdpva-gold transition-colors hover:text-mdpva-cream">
            office@mdpva.in
          </a>
        </p>
        <p class="mt-7 border-t border-mdpva-border-dark pt-5 text-[13px] leading-relaxed text-mdpva-cream/50">
          {t("membership.apply.fees")}
        </p>
      </div>
    </div>
  </section>

  <section class="border-t border-mdpva-border bg-mdpva-white px-5 py-[clamp(48px,7vw,90px)] sm:px-8 lg:px-16">
    <div
      class="mx-auto grid max-w-[1200px] gap-10"
      style="grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));"
    >
      {
        coverage.map((item, i) => (
          <div data-reveal style={`--reveal-delay:${i * 100}ms`}>
            <h2 class="mb-3.5 font-serif text-[22px] font-medium">{item.title}</h2>
            <p class="text-[14.5px] leading-relaxed text-mdpva-body">{item.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <MembershipBenefits />
  <TestimonialsMarquee theme="accent" />
  <Footer />
</Layout>
