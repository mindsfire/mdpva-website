---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import PageHero from "../components/PageHero.astro";
import BoardCommitteeGrid from "../components/BoardCommitteeGrid.astro";
import Footer from "../components/Footer.astro";

const allMembers = await getCollection("board");

// The term with the highest termStartYear is automatically "current" — no
// manual flag to remember when the office adds a new committee in the CMS.
const currentYear = Math.max(...allMembers.map((m) => m.data.termStartYear));
const currentTermLabel = allMembers.find((m) => m.data.termStartYear === currentYear)!.data.term;

const currentMembers = allMembers
  .filter((m) => m.data.termStartYear === currentYear)
  .sort((a, b) => a.data.tier - b.data.tier || a.data.order - b.data.order);

// One card per past term for the archive slider — a generated square year
// tile, not a person's photo, so it reads distinctly from member portraits.
const pastTermYears = [...new Set(allMembers.map((m) => m.data.termStartYear))]
  .filter((y) => y !== currentYear)
  .sort((a, b) => b - a);

const pastTerms = pastTermYears.map((year) => ({
  year,
  term: allMembers.find((m) => m.data.termStartYear === year)!.data.term,
}));
---

<Layout
  title="Board of Directors"
  description={`The executive committee of the Mysuru District Photographers and Videographers Association ® for the ${currentTermLabel} term — office bearers and directors.`}
>
  <Header />
  <PageHero
    eyebrow={`Executive Committee · ${currentTermLabel}`}
    title="Board of Directors"
    description={`The elected office bearers and directors who lead the association through the ${currentTermLabel} term.`}
  />

  <section class="bg-mdpva-paper px-5 py-[clamp(48px,7vw,90px)] sm:px-8 lg:px-16">
    <BoardCommitteeGrid members={currentMembers} />
  </section>

  {
    pastTerms.length > 0 && (
      <section class="border-t border-mdpva-border bg-mdpva-white py-[clamp(48px,7vw,90px)]">
        <div class="mx-auto mb-8 flex max-w-[1200px] flex-wrap items-end justify-between gap-6 px-5 sm:px-8 lg:px-16" data-reveal>
          <div>
            <div class="mb-3.5 text-xs font-semibold tracking-[0.22em] text-mdpva-accent uppercase">Since 2001</div>
            <h2 class="font-serif text-[clamp(26px,3.2vw,40px)] font-normal">Past committees</h2>
          </div>
          <div class="flex gap-2" data-board-terms-nav>
            <button
              type="button"
              data-scroll="prev"
              aria-label="Scroll to previous terms"
              class="flex h-10 w-10 items-center justify-center rounded-full border border-mdpva-border-soft text-mdpva-ink transition-colors hover:border-mdpva-ink disabled:pointer-events-none disabled:opacity-30"
            >
              ←
            </button>
            <button
              type="button"
              data-scroll="next"
              aria-label="Scroll to next terms"
              class="flex h-10 w-10 items-center justify-center rounded-full border border-mdpva-border-soft text-mdpva-ink transition-colors hover:border-mdpva-ink disabled:pointer-events-none disabled:opacity-30"
            >
              →
            </button>
          </div>
        </div>
        <div class="mx-auto max-w-[1200px] px-5 sm:px-8 lg:px-16" data-reveal style="--reveal-delay:100ms">
          <div class="mdpva-hscroll flex snap-x snap-mandatory gap-5 overflow-x-auto py-1 pb-3" style="scrollbar-width: none;">
            {pastTerms.map((pt) => (
              <a
                href={`/board/archive#${pt.term}`}
                class="group flex flex-[0_0_200px] snap-start flex-col items-center gap-3.5 border border-mdpva-border-alt bg-mdpva-paper px-6 py-8 text-center transition-shadow duration-300 hover:shadow-lg"
              >
                <div class="flex h-20 w-20 flex-col items-center justify-center gap-1 rounded-lg border-2 border-mdpva-gold bg-mdpva-ink text-mdpva-cream transition-colors group-hover:bg-mdpva-accent">
                  <span class="font-serif text-2xl leading-none font-semibold">{String(pt.year).slice(-2)}</span>
                  <span class="h-px w-6 bg-mdpva-cream/30" aria-hidden="true" />
                  <span class="text-[10px] tracking-wide text-mdpva-cream/70">{pt.term}</span>
                </div>
                <div class="font-serif text-lg font-medium text-mdpva-ink">{pt.term}</div>
                <div class="text-[12px] tracking-[0.1em] text-mdpva-accent uppercase transition-colors group-hover:text-mdpva-accent-hover">
                  View committee →
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="bg-mdpva-ink px-5 py-[clamp(48px,7vw,80px)] text-mdpva-cream sm:px-8 lg:px-16">
    <div class="mx-auto flex max-w-[840px] flex-col items-center gap-5 text-center" data-reveal>
      <h2 class="font-serif text-[clamp(24px,3vw,36px)] font-normal">
        A committee elected by the members, for the members
      </h2>
      <p class="max-w-[560px] text-[15px] leading-relaxed text-mdpva-cream/70">
        The executive committee is elected every two years at the annual general meeting. Read
        about the association's journey since 2001 on our legacy page.
      </p>
      <a
        href="/about"
        class="rounded-sm border border-mdpva-cream/40 px-6 py-3 text-[13px] font-semibold tracking-wider text-mdpva-cream uppercase transition-colors hover:bg-white hover:text-mdpva-ink"
      >
        Our legacy
      </a>
    </div>
  </section>
  <Footer />
</Layout>

<script>
  const strip = document.querySelector<HTMLElement>(".mdpva-hscroll");
  const prevBtn = document.querySelector<HTMLButtonElement>('[data-board-terms-nav] [data-scroll="prev"]');
  const nextBtn = document.querySelector<HTMLButtonElement>('[data-board-terms-nav] [data-scroll="next"]');

  if (strip && prevBtn && nextBtn) {
    const step = () => strip.querySelector("a")?.clientWidth ?? strip.clientWidth * 0.8;

    const updateButtons = () => {
      const maxScroll = strip.scrollWidth - strip.clientWidth;
      prevBtn.disabled = strip.scrollLeft <= 4;
      nextBtn.disabled = strip.scrollLeft >= maxScroll - 4;
    };

    prevBtn.addEventListener("click", () => {
      strip.scrollBy({ left: -(step() + 20), behavior: "instant" });
    });

    nextBtn.addEventListener("click", () => {
      strip.scrollBy({ left: step() + 20, behavior: "instant" });
    });

    strip.addEventListener("scroll", updateButtons, { passive: true });
    window.addEventListener("resize", updateButtons);
    updateButtons();
  }
</script>
