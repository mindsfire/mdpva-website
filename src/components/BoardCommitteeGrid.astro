---
import { getLocale, useTranslations, pickKn } from "../i18n/utils";

const locale = getLocale(Astro.url);
const t = useTranslations(locale);
import type { CollectionEntry } from "astro:content";

interface Props {
  members: CollectionEntry<"board">[];
}

const { members } = Astro.props;

// Honorary President (tier 1) and President (tier 2) sit side by side as one
// leadership row; Office Bearers (tier 3) and Directors (tier 4) follow.
const leadership = members.filter((m) => m.data.tier === 1 || m.data.tier === 2);
const groups = [
  leadership,
  members.filter((m) => m.data.tier === 3),
  members.filter((m) => m.data.tier === 4),
];

// Portrait sizes shrink down the pyramid; the gold double-ring frame echoes
// the association's printed invitation identity.
const ringSize = ["h-40 w-40 sm:h-44 sm:w-44", "h-28 w-28 sm:h-32 sm:w-32", "h-24 w-24 sm:h-28 sm:w-28"];
const groupLabels = ["", "Office Bearers", "Directors"];
// Directors row is capped so it wraps 4-then-3 instead of a lopsided 5-then-2.
const groupMaxWidth = ["", "", "max-w-[860px]"];
---

<div class="mx-auto flex max-w-[1100px] flex-col items-center">
  {
    groups.map((group, ti) => (
      <>
        {ti > 0 && <div class="mdpva-connector h-10 w-px bg-mdpva-gold sm:h-14" aria-hidden="true" />}
        {groupLabels[ti] && (
          <div
            class="mb-6 border-b border-mdpva-gold/50 pb-2 text-[11px] font-semibold tracking-[0.24em] text-mdpva-accent uppercase"
            data-reveal
          >
            {groupLabels[ti]}
          </div>
        )}
        <div class={`flex flex-wrap items-start justify-center gap-x-8 gap-y-10 sm:gap-x-12 ${groupMaxWidth[ti]}`}>
          {group.map((member, mi) => (
            <figure
              class="m-0 flex w-36 flex-col items-center gap-3.5 text-center sm:w-44"
              data-reveal
              style={`--reveal-delay:${mi * 110}ms`}
            >
              <div class={`relative flex items-center justify-center rounded-full ${ringSize[ti]}`}>
                <span class="absolute inset-0 rounded-full border-2 border-mdpva-gold" aria-hidden="true" />
                <span class="absolute inset-[5px] rounded-full border border-mdpva-accent/70" aria-hidden="true" />
                <img
                  src={member.data.photo}
                  alt={`Portrait of ${member.data.name}`}
                  loading={ti > 1 ? "lazy" : undefined}
                  class="absolute inset-[9px] h-[calc(100%-18px)] w-[calc(100%-18px)] rounded-full object-cover"
                />
              </div>
              <figcaption>
                <div class="font-serif text-[16px] leading-snug font-medium text-mdpva-ink">{member.data.name}</div>
                <div class="mt-1 text-[12px] font-semibold tracking-[0.12em] text-mdpva-accent uppercase">
                  {t(`designation.${member.data.designation}` as any)}
                </div>
                {member.data.note && <div class="mt-1 text-[12px] text-mdpva-muted">{pickKn(member.data, "note", locale)}</div>}
              </figcaption>
            </figure>
          ))}
        </div>
      </>
    ))
  }
</div>
