---
import { getLocale, useTranslations, localizePath } from "../i18n/utils";

const locale = getLocale(Astro.url);
const t = useTranslations(locale);
const L = (path: string) => localizePath(path, locale);
const benefits = [
  {
    number: "01",
    title: t("benefits.1.title"),
    body: t("benefits.1.body"),
  },
  {
    number: "02",
    title: t("benefits.2.title"),
    body: t("benefits.2.body"),
  },
  {
    number: "03",
    title: t("benefits.3.title"),
    body: t("benefits.3.body"),
  },
  {
    number: "04",
    title: t("benefits.4.title"),
    body: t("benefits.4.body"),
  },
];
---

<section id="membership" class="bg-mdpva-ink px-5 py-[clamp(56px,9vw,110px)] text-mdpva-cream sm:px-8 lg:px-16">
  <div class="mx-auto max-w-[1200px]">
    <div class="mb-3.5 text-xs font-semibold tracking-[0.22em] text-mdpva-gold uppercase" data-reveal>
      {t("benefits.eyebrow")}
    </div>
    <h2 class="text-pretty mb-11 max-w-[640px] font-serif text-[clamp(26px,3.2vw,40px)] font-normal" data-reveal style="--reveal-delay:80ms">
      {t("benefits.heading")}
    </h2>
    <div
      class="grid gap-0 border border-mdpva-border-dark"
      style="grid-template-columns: repeat(auto-fit, minmax(min(100%, 480px), 1fr));"
      data-reveal
    >
      {
        benefits.map((benefit) => (
          <div class="-mt-px -ml-px flex flex-col gap-3.5 border border-mdpva-border-dark bg-mdpva-ink p-6 sm:p-10">
            <div class="font-serif text-xl text-mdpva-gold">{benefit.number}</div>
            <h3 class="font-serif text-[22px] font-medium">{benefit.title}</h3>
            <p class="text-sm leading-relaxed text-mdpva-cream/65">{benefit.body}</p>
          </div>
        ))
      }
    </div>
    <div class="mt-9" data-reveal>
      <a
        href={`${L("/membership")}#apply`}
        class="inline-block rounded-sm bg-mdpva-accent px-7 py-3.5 text-sm font-semibold tracking-wider text-mdpva-cream uppercase transition-colors hover:bg-mdpva-accent-hover"
      >
        {t("benefits.cta")}
      </a>
    </div>
  </div>
</section>
